# AbdulInsight AI & Portfolio Environment Variables
# Copy this file to .env.local and fill in your values

# -------------------------------------------------------------
# 1. AI Assistant (AbdulInsight AI Bot)
# -------------------------------------------------------------
# (Optional) Google Gemini API Key for Gemini 2.0 Flash
# Get one free at: https://aistudio.google.com/
GEMINI_API_KEY=

# (Optional) Groq API Key for Llama-3.3-70b-versatile
# Get one free at: https://console.groq.com/
GROQ_API_KEY=

# Note: Even if NO API keys are provided, AbdulInsight AI has a
# built-in Smart Local RAG engine with zero latency that answers
# queries using Hafiz's verified profile and 57 indexed repositories.

# -------------------------------------------------------------
# 2. GitHub Auto-Sync Engine
# -------------------------------------------------------------
# GitHub Personal Access Token (classic or fine-grained)
# Grants higher rate limits (5,000 req/hr instead of 60 req/hr)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# (Optional) Secret token to verify incoming GitHub webhooks
GITHUB_WEBHOOK_SECRET=

# -------------------------------------------------------------
# 3. Admin Portal Security
# -------------------------------------------------------------
# Admin Login Credentials for /admin/login
ADMIN_EMAIL=hafizrehman3321@gmail.com
ADMIN_PASSWORD=AbdulInsight2026!

# JWT Secret for session tokens (generate any random string)
ADMIN_JWT_SECRET=abdul-rehman-portfolio-super-secret-key-2026

# -------------------------------------------------------------
# 4. Email Notifications (Optional)
# -------------------------------------------------------------
# CONTACT_EMAIL_RECEIVER=hafizrehman3321@gmail.com
